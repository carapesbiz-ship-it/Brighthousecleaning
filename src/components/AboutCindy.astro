---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { photos, cindyPortrait } from '../data/photos';

// When a portrait of Cindy is added in src/data/photos.ts it replaces the brand image.
const image = cindyPortrait ?? photos.microwave;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__visual reveal">
      <div class="about__arch">
        <Picture
          src={image.src}
          alt={image.alt}
          formats={['avif']}
                fallbackFormat="webp"
          widths={[400, 640, 900]}
          sizes="(max-width: 900px) 80vw, 440px"
          class="cover"
          style={`object-position:${image.position ?? '50% 50%'}`}
          loading="lazy"
          quality={76}
        />
      </div>
      <div class="about__brandcard on-dark">
        <Logo variant="white" height={50} />
        <p>“What matters most is how people feel after we finish.”</p>
      </div>
      <svg class="about__spark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2c.6 5.3 2.7 7.4 8 8-5.3.6-7.4 2.7-8 8-.6-5.3-2.7-7.4-8-8 5.3-.6 7.4-2.7 8-8Z"></path>
      </svg>
      <div class="about__ring" aria-hidden="true"></div>
    </div>

    <div class="about__copy">
      <p class="eyebrow">Meet Cindy</p>
      <h2 id="about-title">Hi, I’m <span class="em">Cindy.</span></h2>
      <div class="about__text">
        <p class="about__first">
          Bright House began during a season of change, when I was looking for a way to build meaningful work while
          balancing life as a mother. I have always loved the feeling of a clean, organized home, so turning that
          passion into a service felt natural.
        </p>
        <p>
          What matters most to me is how people feel after we finish: comfortable, satisfied, and able to enjoy a fresh
          space that looks organized and smells wonderful.
        </p>
        <p>
          I personally lead each cleaning, usually alongside my regular assistant, so every client receives thoughtful,
          familiar, and personalized service.
        </p>
      </div>

      <div class="about__sign">
        <p class="about__signature" aria-hidden="true">Cindy</p>
        <p class="about__role">
          <strong>{site.owner}</strong>
          <span>Founder, {site.name}</span>
        </p>
      </div>

      <div class="about__actions">
        <a class="btn btn--primary" href="#contact" data-quote-link>
          Tell Me About Your Space
          <Icon name="arrow" />
        </a>
        <span class="lang-badge">
          <span class="lang-badge__dot">ES</span>
          Se habla español
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    overflow: hidden;
  }
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .about__visual {
    position: relative;
    padding: 0 3rem 4rem 0;
    max-width: 480px;
  }
  .about__arch {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5.2;
    border-radius: 999px 999px var(--radius-l) var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-l);
    background: var(--cyan-soft);
  }
  .about__ring {
    position: absolute;
    top: -1.25rem;
    left: -1.25rem;
    right: 1.75rem;
    bottom: 2.75rem;
    border: 1.5px solid var(--cyan);
    border-radius: 999px 999px var(--radius-l) var(--radius-l);
    opacity: 0.55;
  }
  .about__brandcard {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: min(74%, 290px);
    padding: 1.5rem 1.5rem 1.6rem;
    border-radius: 22px;
    background: var(--blue);
    color: var(--white);
    box-shadow: var(--shadow-l);
  }
  .about__brandcard p {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.25;
  }
  .about__spark {
    position: absolute;
    z-index: 2;
    top: 12%;
    right: 1.1rem;
    width: 34px;
    fill: var(--cyan);
  }

  .about__text {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
    max-width: 36rem;
    color: var(--muted);
    font-size: 1.05rem;
  }
  .about__first {
    font-size: var(--step-1);
    color: var(--ink);
  }
  .about__sign {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .about__signature {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 3.4rem;
    line-height: 1;
    color: var(--blue);
    transform: rotate(-4deg);
    padding-right: 1.25rem;
    border-right: 1px solid var(--line);
  }
  .about__role {
    display: grid;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .about__role strong {
    color: var(--blue-ink);
  }
  .about__role span {
    color: var(--muted);
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__visual {
      margin-inline: auto;
      width: 100%;
      max-width: 420px;
    }
  }
  @media (max-width: 480px) {
    .about__visual {
      padding: 0 1.5rem 3.5rem 0;
    }
    .about__signature {
      font-size: 2.8rem;
    }
  }
</style>
