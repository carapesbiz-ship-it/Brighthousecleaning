---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappLink } from '../data/site';
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href="/#top">
      <Logo variant="blue" height={60} loading="eager" />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="btn btn--primary btn--sm header__cta" href="/#contact" data-quote-link>Get a Free Quote</a>
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>Open menu</span>
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list" class="mobile-menu__links">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-menu-link>
                {item.label}
                <Icon name="arrow" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__cta">
        <a class="btn btn--primary btn--block" href="/#contact" data-menu-link data-quote-link>Get a Free Quote</a>
        <a class="btn btn--ghost btn--block" href={whatsappLink()} target="_blank" rel="noopener" data-menu-link>
          <Icon name="whatsapp" class="wa-icon" />
          Message on WhatsApp
        </a>
        <a class="mobile-menu__phone" href={site.phone.href}>
          <Icon name="phone" size={18} />
          {site.phone.display}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .header.is-compact {
    border-bottom-color: var(--line-soft);
    box-shadow: 0 8px 30px -22px rgb(32 36 61 / 0.35);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
    transition: height 0.3s var(--ease);
  }
  .header.is-compact .header__inner {
    height: 64px;
  }
  .header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: none;
    transform-origin: left center;
    transition: transform 0.3s var(--ease);
  }
  .header.is-compact .header__brand {
    transform: scale(0.85);
  }

  .header__nav ul {
    display: flex;
    gap: clamp(0.4rem, 1.4vw, 1.5rem);
    margin: 0;
  }
  .header__nav a {
    position: relative;
    display: inline-block;
    padding: 0.6rem 0.35rem;
    font-family: var(--font-accent);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: var(--cyan);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='true']::after {
    transform: scaleX(1);
  }
  .header__nav a:hover {
    color: var(--blue);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .header__toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--blue-ink);
  }
  .header__toggle :global(.icon-close) {
    display: none;
  }
  .header__toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }
  .header__toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--menu-top, var(--header-h)) 0 0 0;
    background: var(--white);
    overflow-y: auto;
    padding-block: 1rem 2.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .mobile-menu__links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 600;
    color: var(--blue-ink);
    text-decoration: none;
  }
  .mobile-menu__links a :global(svg) {
    color: var(--cyan);
  }
  .mobile-menu__cta {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .mobile-menu__phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    font-weight: 600;
    color: var(--blue);
    text-decoration: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in 0.3s var(--ease);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 1080px) {
    .header__nav {
      display: none;
    }
    .header__toggle {
      display: grid;
    }
  }
  @media (max-width: 480px) {
    .header__cta {
      display: none;
    }
    /* Stays above the identity manual's 47px minimum logo height */
    .header__brand :global(.logo) {
      height: 52px;
    }
    .header.is-compact .header__brand {
      transform: none;
    }
  }
  @media (min-width: 1081px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>
