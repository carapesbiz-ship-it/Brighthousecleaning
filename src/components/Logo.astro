---
/**
 * Bright House logo.
 *
 * Uses the official artwork when it is present in /public/brand:
 *   bright-house-logo-blue.svg   (header, light backgrounds)
 *   bright-house-logo-white.svg  (footer, dark backgrounds)
 * The file is displayed as-is: never recoloured, redrawn, or stretched.
 * Until the files are added, a typographic name treatment is shown instead.
 */
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../data/site';

interface Props {
  variant?: 'blue' | 'white';
  height?: number;
  class?: string;
}
const { variant = 'blue', height = 56, class: className } = Astro.props;

const file = `bright-house-logo-${variant}.svg`;
const filePath = path.join(process.cwd(), 'public', 'brand', file);
let official: { src: string; width: number; height: number } | null = null;

if (fs.existsSync(filePath)) {
  const svg = fs.readFileSync(filePath, 'utf8');
  const vb = svg.match(/viewBox=["']\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)/i);
  const ratio = vb ? Number(vb[1]) / Number(vb[2]) : 2.2;
  official = { src: `/brand/${file}`, width: Math.round(height * ratio), height };
}
---

{
  official ? (
    <img
      class:list={['logo-img', className]}
      src={official.src}
      width={official.width}
      height={official.height}
      alt={site.name}
      decoding="async"
    />
  ) : (
    <span class:list={['wordmark', `wordmark--${variant}`, className]} style={`--wm-h:${height}px`}>
      <span class="wordmark__name">
        Bright House
        <svg class="wordmark__spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 2c.6 5.3 2.7 7.4 8 8-5.3.6-7.4 2.7-8 8-.6-5.3-2.7-7.4-8-8 5.3-.6 7.4-2.7 8-8Z" />
        </svg>
      </span>
      <span class="wordmark__sub">Cleaning Services</span>
    </span>
  )
}

<style>
  .logo-img {
    height: var(--logo-h, auto);
    width: auto;
  }
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    height: var(--wm-h);
    line-height: 1;
    color: var(--blue);
    white-space: nowrap;
  }
  .wordmark--white {
    color: var(--white);
  }
  .wordmark__name {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--wm-h) * 0.5);
    letter-spacing: -0.005em;
    padding-right: 0.55em;
  }
  .wordmark__spark {
    position: absolute;
    top: -0.18em;
    right: 0;
    width: 0.5em;
    height: 0.5em;
    fill: var(--cyan);
  }
  .wordmark__sub {
    margin-top: 0.75em;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: calc(var(--wm-h) * 0.155);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
