---
/**
 * Official Bright House logo, served from /public/brand:
 *   bright-house-logo-blue.svg   (header, light backgrounds)
 *   bright-house-logo-white.svg  (footer, dark blue backgrounds)
 * The artwork is displayed as-is — never recoloured, redrawn, or stretched.
 * Width is derived from the SVG viewBox so the proportions are always exact.
 * The identity manual's minimum web size is 106 × 47 px, so keep height ≥ 47.
 */
import fs from 'node:fs';
import path from 'node:path';
import { site } from '../data/site';

interface Props {
  variant?: 'blue' | 'white';
  height?: number;
  class?: string;
  /** Load eagerly (above the fold) or lazily */
  loading?: 'eager' | 'lazy';
}
const { variant = 'blue', height = 52, class: className, loading = 'lazy' } = Astro.props;

const file = `bright-house-logo-${variant}.svg`;
const svg = fs.readFileSync(path.join(process.cwd(), 'public', 'brand', file), 'utf8');
const vb = svg.match(/viewBox=["']\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)/i);
if (!vb) throw new Error(`Logo ${file} has no viewBox`);
const ratio = Number(vb[1]) / Number(vb[2]);
const width = Math.round(height * ratio);
---

<img
  class:list={['logo', className]}
  src={`/brand/${file}`}
  width={width}
  height={height}
  style={`--logo-h:${height}px`}
  alt={site.name}
  loading={loading}
  decoding="async"
/>

<style>
  .logo {
    display: block;
    height: var(--logo-h);
    width: auto;
    max-width: none;
  }
</style>
