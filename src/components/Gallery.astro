---
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { photos, gallery } from '../data/photos';

const items = await Promise.all(
  gallery.map(async (g, i) => {
    const photo = photos[g.key];
    const full = await getImage({ src: photo.src, width: Math.min(1400, photo.src.width), format: 'webp', quality: 82 });
    return { ...g, ...photo, full: full.src, area: String.fromCharCode(97 + i) };
  }),
);
---

<section class="section section--tint gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head gallery__head">
      <div>
        <p class="eyebrow">Real work</p>
        <h2 id="gallery-title">Fresh spaces, <span class="em">thoughtful details.</span></h2>
      </div>
      <p class="lede">A look at real homes and spaces cared for by Bright House.</p>
    </div>

    <ul class="gallery__grid" role="list" data-gallery>
      {
        items.map((item, i) => (
          <li class:list={['gallery__item', `gallery__item--${item.shape}`, 'reveal']} style={`grid-area:${item.area};--reveal-delay:${(i % 3) * 0.08}s`}>
            <button
              type="button"
              class="gallery__btn"
              data-lightbox-open={i}
              data-full={item.full}
              data-caption={item.caption}
              data-alt={item.alt}
            >
              <Picture
                src={item.src}
                alt={item.alt}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[360, 560, 800]}
                sizes="(max-width: 700px) 46vw, (max-width: 1100px) 45vw, 400px"
                class="cover"
                style={`object-position:${item.position}`}
                loading="lazy"
                quality={74}
              />
              <span class="gallery__caption">
                <span>{item.caption}</span>
                <Icon name="expand" size={18} />
              </span>
              <span class="visually-hidden">, view larger</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="gallery__foot">
      <p class="gallery__note">
        <Icon name="heart" size={16} />
        Photos shared with permission.
      </p>
      <a class="text-link" href={site.social.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" />
        See more of our work on Instagram
        <Icon name="arrow" />
      </a>
    </div>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <div class="lightbox__inner">
      <figure class="lightbox__figure">
        <img data-lightbox-img alt="" decoding="async" />
        <figcaption>
          <span data-lightbox-caption></span>
          <span class="lightbox__count" data-lightbox-count></span>
        </figcaption>
      </figure>
      <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Close photo viewer">
        <Icon name="close" />
      </button>
      <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label="Previous photo">
        <Icon name="chevronLeft" />
      </button>
      <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label="Next photo">
        <Icon name="chevronRight" />
      </button>
    </div>
  </dialog>
</section>

<style>
  .gallery__head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    max-width: none;
  }
  .gallery__head .lede {
    margin: 0;
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(180px, 17vw, 250px);
    grid-template-areas:
      'a b c'
      'a d c'
      'e d f';
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    margin: 0;
  }
  .gallery__item {
    min-width: 0;
  }
  .gallery__btn {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cyan-soft);
    cursor: zoom-in;
  }
  .gallery__btn :global(picture),
  .gallery__btn :global(img) {
    width: 100%;
    height: 100%;
  }
  .gallery__btn :global(img) {
    transition: transform 0.9s var(--ease);
  }
  .gallery__btn:hover :global(img),
  .gallery__btn:focus-visible :global(img) {
    transform: scale(1.045);
  }
  .gallery__caption {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.94);
    color: var(--blue-ink);
    font-family: var(--font-accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  .gallery__caption :global(svg) {
    flex: none;
    color: var(--blue);
  }
  .gallery__btn:hover .gallery__caption,
  .gallery__btn:focus-visible .gallery__caption {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .gallery__caption {
      opacity: 1;
      transform: none;
      left: auto;
      padding: 0.45rem;
    }
    .gallery__caption span {
      display: none;
    }
  }
  .gallery__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .gallery__note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .gallery__note :global(svg) {
    color: var(--cyan);
  }

  @media (max-width: 800px) {
    .gallery__head {
      grid-template-columns: 1fr;
    }
    .gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: clamp(140px, 30vw, 220px);
      grid-template-areas:
        'a b'
        'a c'
        'd c'
        'd e'
        'f f';
    }
  }

  /* ---- Lightbox ---- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--white);
  }
  .lightbox::backdrop {
    background: rgb(20 22 52 / 0.92);
  }
  .lightbox__inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 4.5rem 4.5rem 2rem;
  }
  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    max-width: 100%;
    max-height: 100%;
  }
  .lightbox__figure img {
    max-width: min(100%, 1100px);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 14px;
  }
  .lightbox figcaption {
    display: flex;
    gap: 1rem;
    font-family: var(--font-accent);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .lightbox__count {
    color: var(--cyan);
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.18);
  }
  .lightbox__btn:focus-visible {
    outline-color: var(--cyan);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }
  .lightbox__prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  @media (max-width: 640px) {
    .lightbox__inner {
      padding: 4.5rem 0.75rem 5.5rem;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1.25rem;
      translate: none;
    }
    .lightbox__prev {
      left: calc(50% - 60px);
    }
    .lightbox__next {
      right: calc(50% - 60px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] .lightbox__figure {
      animation: lb-in 0.35s var(--ease);
    }
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }
</style>
