---
import Icon from './Icon.astro';
import { steps } from '../data/site';
const icons = ['chat', 'calendar', 'sparkle'];
---

<section class="section section--cyan how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">Three simple steps to a <span class="em">brighter space.</span></h2>
    </div>

    <ol class="how__steps" role="list">
      {
        steps.map((step, i) => (
          <li class="how__step reveal" style={`--reveal-delay:${i * 0.12}s`}>
            <div class="how__marker">
              <span class="how__icon">
                <Icon name={icons[i]} size={26} />
              </span>
              <span class="how__num">Step {i + 1}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="how__cta">
      <a class="btn btn--primary" href="#contact" data-quote-link>
        Start Your Free Quote
        <Icon name="arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .how__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: 0;
    counter-reset: step;
  }
  .how__steps::before {
    content: '';
    position: absolute;
    top: 38px;
    left: 16%;
    right: 16%;
    border-top: 1.5px dashed rgb(62 64 149 / 0.3);
  }
  .how__step {
    position: relative;
    text-align: center;
    padding: 0 0.5rem;
  }
  .how__marker {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .how__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--white);
    color: var(--blue);
    box-shadow:
      0 0 0 8px var(--cyan-soft),
      var(--shadow);
  }
  .how__num {
    font-family: var(--font-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .how__step h3 {
    margin-bottom: 0.6rem;
  }
  .how__step p {
    color: var(--muted);
    max-width: 21rem;
    margin-inline: auto;
  }
  .how__cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  @media (max-width: 800px) {
    .how__steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 30rem;
      margin-inline: auto;
    }
    .how__steps::before {
      top: 38px;
      bottom: 38px;
      left: 38px;
      right: auto;
      border-top: 0;
      border-left: 1.5px dashed rgb(62 64 149 / 0.3);
    }
    .how__step {
      display: grid;
      grid-template-columns: 76px 1fr;
      column-gap: 1.25rem;
      text-align: left;
      padding: 0;
    }
    .how__marker {
      grid-row: span 2;
      margin: 0;
      align-content: start;
    }
    .how__step p {
      margin: 0;
    }
    .how__step h3 {
      align-self: end;
      font-size: 1.5rem;
    }
  }
</style>
