---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import heroImage from '../assets/photos/hero-background-cindy-v1.webp';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-wa-hide>
  <div class="hero__media">
    <Picture
      src={heroImage}
      alt="Bright House cleaner caring for a modern kitchen"
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      class="hero__img"
      loading="eager"
      fetchpriority="high"
      quality={80}
    />
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">Personalized cleaning across Metro Vancouver</p>
    <h1 id="hero-title">
      <span class="hero__line">A brighter,</span>
      <span class="hero__line">fresher home,</span>
      <span class="hero__line hero__accent">without the stress.</span>
    </h1>
    <p class="hero__lede">
      Reliable home and commercial cleaning personally led by Cindy, with thoughtful attention to every room and every
      detail.
    </p>

    <div class="hero__ctas">
      <a class="btn hero__btn-primary" href="#contact" data-quote-link>
        Get a Free Quote
        <Icon name="arrow" />
      </a>
      <a class="btn btn--outline-light hero__btn-secondary" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" />
        Message on WhatsApp
      </a>
    </div>

    <p class="hero__price">
      <Icon name="sparkle" size={18} />
      Regular cleaning from <strong>$140 CAD</strong>
    </p>

    <ul class="hero__trust" role="list" aria-label="Why clients trust Bright House">
      {
        site.heroTrust.map((item) => (
          <li>
            <span class="hero__check" aria-hidden="true">
              <Icon name="check" size={14} />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(640px, 50vw + 120px, 700px);
    padding-block: clamp(2.5rem, 1.5rem + 2vw, 3.25rem) clamp(4.25rem, 3.5rem + 2vw, 5rem);
    background: var(--blue-ink);
    color: var(--white);
    overflow: hidden;
  }

  /* ---- Photograph ---- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 45%;
  }

  /* Deep-blue brand overlay: strong behind the copy, clear over the cleaner. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgb(35 37 82 / 0.94) 0%,
        rgb(45 47 115 / 0.86) 30%,
        rgb(62 64 149 / 0.55) 50%,
        rgb(62 64 149 / 0.12) 68%,
        rgb(62 64 149 / 0) 80%
      ),
      linear-gradient(0deg, rgb(35 37 82 / 0.35), transparent 30%);
  }

  /* ---- Copy ---- */
  .hero__content {
    position: relative;
  }
  .hero__content > * {
    max-width: 40rem;
  }
  .hero__eyebrow {
    color: var(--white);
    letter-spacing: 0.18em;
  }
  .hero__eyebrow::before {
    background: var(--cyan);
  }
  .hero h1 {
    color: var(--white);
    font-size: clamp(2.6rem, 1.5rem + 3.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.012em;
  }
  .hero__line {
    display: block;
  }
  .hero__accent {
    font-style: italic;
    font-weight: 500;
    color: var(--cyan-on-blue);
  }
  .hero__lede {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }
  /* Cyan brand button with dark ink text (white on cyan would fail contrast). */
  .hero__btn-primary {
    --btn-bg: var(--cyan);
    --btn-fg: var(--blue-ink);
    --btn-border: var(--cyan);
    min-height: 56px;
    padding-inline: 1.9rem;
    box-shadow: 0 12px 28px -14px rgb(63 198 240 / 0.8);
  }
  .hero__btn-primary:hover {
    --btn-bg: #6fd6f5;
    --btn-border: #6fd6f5;
    transform: translateY(-2px);
  }
  .hero__btn-secondary {
    min-height: 56px;
    padding-inline: 1.6rem;
    --btn-border: rgb(255 255 255 / 0.7);
  }
  .hero .btn:focus-visible {
    outline-color: var(--white);
  }

  .hero__price {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    font-size: 0.98rem;
    color: rgb(255 255 255 / 0.88);
  }
  .hero__price :global(svg) {
    color: var(--cyan);
    flex: none;
  }
  .hero__price strong {
    color: var(--white);
    font-weight: 700;
  }

  /* Translucent trust band */
  .hero__trust {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0;
    margin: 1.5rem 0 0;
    padding: 0.6rem 0.6rem;
    max-width: none !important;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.2rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--white);
    white-space: nowrap;
  }
  .hero__trust li + li {
    border-left: 1px solid rgb(255 255 255 / 0.28);
  }
  .hero__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--cyan);
    color: var(--blue-ink);
  }

  /* ---- Tablet ---- */
  @media (max-width: 1023px) {
    .hero {
      min-height: 0;
    }
    .hero__lede {
      max-width: 30rem;
    }
    .hero__media :global(.hero__img) {
      object-position: 72% 45%;
    }
    .hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgb(35 37 82 / 0.94) 0%,
          rgb(45 47 115 / 0.84) 45%,
          rgb(62 64 149 / 0.45) 72%,
          rgb(62 64 149 / 0.15) 100%
        ),
        linear-gradient(0deg, rgb(35 37 82 / 0.4), transparent 35%);
    }
  }

  /* ---- Mobile: stronger overlay, cleaner kept on the right ---- */
  @media (max-width: 767px) {
    .hero {
      padding-block: 2.5rem 4.5rem;
    }
    /* Cleaner framed on the right; overlay strongest behind the copy on the left. */
    .hero__media :global(.hero__img) {
      object-position: 97% 30%;
    }
    .hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgb(35 37 82 / 0.93) 0%,
          rgb(45 47 115 / 0.82) 45%,
          rgb(62 64 149 / 0.5) 75%,
          rgb(62 64 149 / 0.3) 100%
        ),
        linear-gradient(0deg, rgb(35 37 82 / 0.6), transparent 45%);
    }
    .hero__content > * {
      max-width: 100%;
    }
    .hero__eyebrow,
    .hero h1,
    .hero__lede {
      text-shadow: 0 1px 12px rgb(20 22 52 / 0.45);
    }
    .hero h1 {
      font-size: clamp(2.35rem, 1.2rem + 5.6vw, 3rem);
    }
    .hero__lede {
      font-size: 1.05rem;
    }
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 0.5rem;
      width: 100%;
      padding: 0.9rem 1rem;
      border-radius: 18px;
    }
    .hero__trust li {
      padding: 0;
      font-size: 0.9rem;
      white-space: normal;
    }
    .hero__trust li + li {
      border-left: 0;
    }
  }
</style>
