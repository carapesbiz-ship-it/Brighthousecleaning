---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import { photos, heroSlides, heroVideo } from '../data/photos';

const slides = heroSlides.map((k) => photos[k]);
const sizes = '(max-width: 767px) 92vw, (max-width: 1100px) 46vw, 520px';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-wa-hide>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Personalized cleaning across Metro Vancouver</p>
      <h1 id="hero-title">
        A brighter, fresher home&nbsp;— <span class="em">without the stress.</span>
      </h1>
      <p class="lede hero__lede">
        Reliable home and commercial cleaning personally led by Cindy, with thoughtful attention to every room and
        every detail.
      </p>

      <div class="hero__ctas">
        <a class="btn btn--primary" href="#contact" data-quote-link>
          Get a Free Quote
          <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa-icon" />
          Message on WhatsApp
        </a>
      </div>

      <p class="hero__price">
        <Icon name="sparkle" class="sparkle" size={18} />
        Regular cleaning from <strong>$140 CAD</strong>
      </p>

      <ul class="hero__trust" role="list" aria-label="Why clients trust Bright House">
        {
          site.heroTrust.map((item) => (
            <li>
              <Icon name="check" size={16} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__backdrop" aria-hidden="true"></div>
      <svg class="hero__spark hero__spark--a" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2c.6 5.3 2.7 7.4 8 8-5.3.6-7.4 2.7-8 8-.6-5.3-2.7-7.4-8-8 5.3-.6 7.4-2.7 8-8Z"></path>
      </svg>
      <svg class="hero__spark hero__spark--b" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2c.6 5.3 2.7 7.4 8 8-5.3.6-7.4 2.7-8 8-.6-5.3-2.7-7.4-8-8 5.3-.6 7.4-2.7 8-8Z"></path>
      </svg>

      {
        heroVideo ? (
          <div class="hero__frame">
            <video
              class="cover"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={photos[heroVideo.poster].src.src}
              aria-label="Bright House cleaning in progress"
            >
              <source src={heroVideo.src} type="video/mp4" />
            </video>
          </div>
        ) : (
          <div
            class="hero__frame"
            data-slideshow
            role="group"
            aria-roledescription="carousel"
            aria-label="Bright House at work"
          >
            {slides.map((photo, i) => (
              <figure
                class:list={['hero__slide', i === 0 && 'is-active']}
                data-slide
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${slides.length}`}
                aria-hidden={i === 0 ? undefined : 'true'}
              >
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif']}
                fallbackFormat="webp"
                  widths={[420, 640, 900, 1100]}
                  sizes={sizes}
                  class="cover"
                  style={`object-position:${photo.position}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  quality={78}
                />
              </figure>
            ))}

            <div class="hero__controls">
              <button class="hero__pause" type="button" data-slide-pause aria-label="Pause slideshow">
                <Icon name="pause" size={16} class="i-pause" />
                <Icon name="play" size={16} class="i-play" />
              </button>
              <div class="hero__dots">
                {slides.map((_, i) => (
                  <button
                    type="button"
                    class="hero__dot"
                    data-slide-dot={i}
                    aria-label={`Show photo ${i + 1}`}
                    aria-current={i === 0 ? 'true' : undefined}
                  />
                ))}
              </div>
            </div>
          </div>
        )
      }

      <div class="hero__card" aria-hidden="true">
        <span class="hero__card-icon"><Icon name="heart" size={20} /></span>
        <span>
          <strong>Personally led by Cindy</strong>
          <small>Familiar faces, every visit</small>
        </span>
      </div>

      <div class="hero__lang lang-badge">
        <span class="lang-badge__dot">ES</span>
        English &amp; Spanish
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background: linear-gradient(180deg, var(--offwhite) 0%, var(--white) 75%);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    top: -20%;
    right: -12%;
    width: 62vw;
    height: 62vw;
    max-width: 900px;
    max-height: 900px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(63 198 240 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .hero__copy h1 {
    max-width: 14.5ch;
  }
  .hero__copy .em {
    display: inline;
  }
  .hero__lede {
    margin-top: 1.5rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.25rem;
  }
  .hero__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .hero__price strong {
    color: var(--blue-ink);
    font-weight: 700;
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    max-width: 34rem;
  }
  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--blue-ink);
  }
  .hero__trust :global(svg) {
    color: var(--blue);
    padding: 2px;
    border-radius: 50%;
    background: var(--cyan-soft);
    width: 20px;
    height: 20px;
  }

  /* ---- Visual composition ---- */
  .hero__visual {
    position: relative;
    justify-self: end;
    width: min(100%, 520px);
    padding: 0 0 2.5rem 2.5rem;
  }
  .hero__backdrop {
    position: absolute;
    right: -2.25rem;
    top: 2.5rem;
    bottom: 0;
    left: 0;
    border-radius: 220px 220px var(--radius-l) var(--radius-l);
    background: linear-gradient(160deg, var(--cyan-soft), var(--cyan-mist));
  }
  .hero__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 200px 200px var(--radius-l) var(--radius-l);
    overflow: hidden;
    background: var(--cyan-soft);
    box-shadow: var(--shadow-l);
    isolation: isolate;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }
  .hero__slide.is-active {
    opacity: 1;
  }
  .hero__slide :global(img) {
    transform: scale(1.03);
    transition: transform 6s linear;
  }
  .hero__slide.is-active :global(img) {
    transform: scale(1.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide :global(img) {
      transition: none;
      transform: none !important;
    }
  }

  .hero__controls {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-s);
  }
  .hero__dots {
    display: flex;
  }
  .hero__dot,
  .hero__pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--blue-ink);
  }
  .hero__dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    transition:
      background-color 0.3s,
      transform 0.3s;
  }
  .hero__dot[aria-current='true']::before {
    background: var(--blue);
    transform: scale(1.15);
  }
  .hero__pause :global(.i-play) {
    display: none;
  }
  .hero__pause.is-paused :global(.i-play) {
    display: block;
  }
  .hero__pause.is-paused :global(.i-pause) {
    display: none;
  }
  .hero__pause:hover,
  .hero__dot:hover {
    background: var(--cyan-soft);
  }

  .hero__card {
    position: absolute;
    left: 0;
    bottom: 5.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem 0.85rem 0.85rem;
    border-radius: 16px;
    background: var(--white);
    box-shadow: var(--shadow);
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .hero__card strong {
    display: block;
    color: var(--blue-ink);
    font-weight: 700;
  }
  .hero__card small {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .hero__card-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--blue);
    color: var(--white);
  }
  .hero__lang {
    position: absolute;
    top: 1.25rem;
    right: -1rem;
    box-shadow: var(--shadow);
  }
  .hero__spark {
    position: absolute;
    fill: var(--cyan);
    z-index: 2;
  }
  .hero__spark--a {
    width: 30px;
    top: 5.5rem;
    left: 0.5rem;
  }
  .hero__spark--b {
    width: 16px;
    top: 3.9rem;
    left: 2.6rem;
    fill: var(--blue);
    opacity: 0.6;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__spark--a {
      animation: twinkle 5s ease-in-out infinite;
    }
    .hero__spark--b {
      animation: twinkle 5s ease-in-out 1.6s infinite;
    }
  }
  @keyframes twinkle {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
    50% {
      transform: scale(0.72) rotate(20deg);
      opacity: 0.55;
    }
  }

  /* ---- Tablet ---- */
  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__copy h1 {
      max-width: 16ch;
    }
    .hero__visual {
      justify-self: center;
      width: min(100%, 560px);
    }
  }

  /* ---- Mobile: one strong image, CTAs within reach ---- */
  @media (max-width: 767px) {
    .hero {
      padding-top: 2rem;
    }
    .hero__ctas {
      flex-direction: column;
    }
    .hero__ctas .btn {
      width: 100%;
    }
    .hero__visual {
      padding: 0 0 1.5rem 0;
    }
    .hero__backdrop {
      right: -1rem;
      left: 1.5rem;
      top: 1.5rem;
      border-radius: var(--radius-l);
    }
    .hero__frame {
      aspect-ratio: 5 / 5.4;
      border-radius: 140px 140px var(--radius-l) var(--radius-l);
    }
    .hero__slide:not(:first-child),
    .hero__controls,
    .hero__spark--b {
      display: none;
    }
    .hero__slide:first-child {
      opacity: 1;
    }
    .hero__card {
      left: -0.25rem;
      bottom: 0;
    }
    .hero__lang {
      right: -0.25rem;
      top: 0.75rem;
    }
    .hero__spark--a {
      top: 2.5rem;
      left: -0.5rem;
    }
  }
</style>
