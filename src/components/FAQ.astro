---
import Icon from './Icon.astro';
import { faqs, site, whatsappLink } from '../data/site';
---

<section class="section section--tint faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__intro">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title">Questions, <span class="em">answered.</span></h2>
      <p class="lede">Everything you need to know before your first clean. Still curious? Cindy is happy to help.</p>
      <div class="faq__contact">
        <a class="btn btn--ghost btn--sm" href={whatsappLink('Hi Cindy! I have a question about your cleaning services.')} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="wa-icon" />
          Ask on WhatsApp
        </a>
        <a class="text-link" href={site.phone.href}>
          <Icon name="phone" />
          {site.phone.display}
        </a>
      </div>
    </div>

    <div class="faq__list" data-accordion>
      {
        faqs.map((item, i) => (
          <div class="faq__item">
            <h3 class="faq__q">
              <button
                type="button"
                id={`faq-btn-${i}`}
                aria-expanded="false"
                aria-controls={`faq-panel-${i}`}
                data-accordion-btn
              >
                <span>{item.q}</span>
                <span class="faq__icon" aria-hidden="true">
                  <Icon name="plus" size={20} />
                </span>
              </button>
            </h3>
            <div class="faq__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`} data-accordion-panel>
              <div class="faq__panel-inner">
                <p>{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .faq__intro {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .faq__intro .lede {
    margin-top: 1.1rem;
  }
  .faq__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .faq__list {
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__q {
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }
  .faq__q button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    min-height: 64px;
    padding: 1.1rem 0.25rem;
    border: 0;
    background: none;
    text-align: left;
    color: var(--blue-ink);
  }
  .faq__q button:hover {
    color: var(--blue);
  }
  .faq__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--blue);
    transition:
      transform 0.35s var(--ease),
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .faq__q button[aria-expanded='true'] .faq__icon {
    transform: rotate(45deg);
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white);
  }
  /* Panels are open without JS; the script collapses them on load. */
  .faq__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.4s var(--ease);
  }
  .faq__panel.is-collapsed {
    grid-template-rows: 0fr;
  }
  .faq__panel-inner {
    overflow: hidden;
  }
  .faq__panel.is-collapsed .faq__panel-inner {
    visibility: hidden;
    transition: visibility 0s 0.4s;
  }
  .faq__panel-inner p {
    padding: 0 3.5rem 1.4rem 0.25rem;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__panel,
    .faq__icon {
      transition: none;
    }
  }
  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__intro {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .faq__panel-inner p {
      padding-right: 0.25rem;
    }
  }
</style>
