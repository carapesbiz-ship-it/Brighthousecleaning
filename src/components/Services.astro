---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { services, pricingDisclaimer, type Service } from '../data/site';
import { servicePhotos } from '../data/photos';

const byId = (id: Service['id']) => services.find((s) => s.id === id)!;
// Display (and reading) order of the service cards.
const ordered = [byId('regular'), byId('deep'), byId('move'), byId('commercial'), byId('airbnb')];

// Every card uses the same 16:9 frame and responsive sizes so all five photos match.
const mediaSizes = '(max-width: 820px) 92vw, 590px';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head services__head">
      <div>
        <p class="eyebrow">Our services</p>
        <h2 id="services-title">Cleaning designed around <span class="em">your space.</span></h2>
      </div>
      <p class="lede">
        Every home and business is different. We tailor each service to the size, condition, and priorities of your
        space.
      </p>
    </div>

    <div class="services__grid">
      {
        ordered.map((s, i) => {
          const photo = servicePhotos[s.id];
          const media = (
            <div class="svc__media">
              <Picture
                src={photo.src}
                alt={photo.alt}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[480, 720, 960, 1200]}
                sizes={mediaSizes}
                class="cover"
                style={`object-position:${photo.position}`}
                loading="lazy"
                quality={76}
              />
            </div>
          );
          const top = (
            <div class="svc__top">
              <span class="svc__icon">
                <Icon name={s.icon} size={24} />
              </span>
              <p class="svc__price">{s.price}</p>
            </div>
          );
          const cta = (
            <a class="btn btn--primary btn--sm svc__cta" href={`/?service=${s.id}#contact`} data-service={s.id}>
              Request This Service<span class="visually-hidden">: {s.name}</span>
            </a>
          );

          if (s.id === 'move') return (
            <article class="svc svc--photo svc--feature reveal" aria-labelledby={`svc-${s.id}`}>
              {media}
              <div class="svc__body svc__main">
                {top}
                <h3 id={`svc-${s.id}`}>{s.name}</h3>
                <p class="svc__desc">{s.description}</p>
                <p class="svc__label">{s.listLabel}</p>
                <ul class="checklist" role="list">
                  {s.inclusions.map((item) => (
                    <li>
                      <Icon name="check" size={16} />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="svc__aside">
                <div class="svc__extras">
                  <p class="svc__label">{s.extrasLabel}</p>
                  <ul class="checklist checklist--plus" role="list">
                    {s.extras?.map((item) => (
                      <li>
                        <Icon name="plus" size={16} />
                        {item}
                      </li>
                    ))}
                  </ul>
                  <p class="svc__note svc__note--box">
                    <Icon name="sparkle" size={18} />
                    {s.note}
                  </p>
                </div>
              </div>
              <div class="svc__foot">{cta}</div>
            </article>
          );

          return (
            <article class="svc svc--photo reveal" style={`--reveal-delay:${(i % 2) * 0.1}s`} aria-labelledby={`svc-${s.id}`}>
              {media}
              <div class="svc__body">
                {top}
                <h3 id={`svc-${s.id}`}>{s.name}</h3>
                <p class="svc__desc">{s.description}</p>
                <p class="svc__label">{s.listLabel}</p>
                <ul class="checklist checklist--cols" role="list">
                  {s.inclusions.map((item) => (
                    <li>
                      <Icon name="check" size={16} />
                      {item}
                    </li>
                  ))}
                </ul>
                {s.note && <p class="svc__note">{s.note}</p>}
                {cta}
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="services__disclaimer">
      <Icon name="alert" size={18} />
      <span>{pricingDisclaimer}</span>
    </p>
  </div>
</section>

<style>
  .services__head {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.5rem 4rem;
    align-items: end;
    max-width: none;
  }
  .services__head .lede {
    margin: 0;
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    --svc-gap: clamp(1.25rem, 2vw, 1.75rem);
    gap: var(--svc-gap);
  }
  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-s);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .svc:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .svc__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--cyan-soft);
  }
  .svc__media :global(img) {
    transition: transform 0.8s var(--ease);
  }
  .svc:hover .svc__media :global(img) {
    transform: scale(1.04);
  }
  .svc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }
  .svc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }
  .svc--photo .svc__top {
    margin-top: calc(-1 * clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) - 28px);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--blue);
    color: var(--white);
    box-shadow: 0 10px 20px -10px rgb(62 64 149 / 0.8);
    position: relative;
  }
  .svc__price {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--blue-ink);
    background: var(--cyan-soft);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }
  .svc--photo .svc__price {
    align-self: flex-end;
  }
  .svc h3 {
    margin-bottom: 0.6rem;
  }
  .svc__desc {
    color: var(--muted);
    margin-bottom: 1.4rem;
  }
  .svc__label {
    font-family: var(--font-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.75rem;
  }
  .checklist {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.95rem;
  }
  .checklist--cols {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.25rem;
  }
  .checklist li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    line-height: 1.45;
  }
  .checklist :global(svg) {
    flex: none;
    margin-top: 0.15em;
    width: 18px;
    height: 18px;
    padding: 2px;
    border-radius: 50%;
    background: var(--cyan-soft);
    color: var(--blue);
  }
  .checklist--plus :global(svg) {
    background: var(--white);
    border: 1px solid var(--line);
  }
  .svc__note {
    margin-top: 1.25rem;
    font-size: 0.92rem;
    font-style: italic;
    color: var(--blue);
    font-weight: 500;
  }
  .svc__note--box {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-style: normal;
    padding: 0.9rem 1rem;
    border-radius: 14px;
    background: var(--white);
    border: 1px dashed rgb(62 64 149 / 0.35);
    color: var(--blue-ink);
  }
  .svc__note--box :global(svg) {
    flex: none;
    color: var(--cyan);
    margin-top: 0.1em;
  }
  .svc__cta {
    align-self: flex-start;
    margin-top: auto;
  }
  .svc__desc + .svc__label,
  .checklist + .svc__cta,
  .svc__note + .svc__cta {
    margin-top: auto;
  }
  .svc__body > .checklist,
  .svc__body > .svc__note {
    margin-bottom: 1.75rem;
  }
  .svc__desc + .svc__label {
    margin-top: 0;
  }

  /* Feature card (Move In / Move Out): spans both columns, but its photo sits in
     the left column at exactly the same size as every other card's photo. */
  .svc--feature {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--svc-gap);
    grid-template-areas:
      'media main'
      'aside main'
      'aside foot';
    grid-template-rows: auto 1fr auto;
  }
  .svc--feature .svc__media {
    grid-area: media;
  }
  .svc__main {
    grid-area: main;
    padding-bottom: 0;
  }
  .svc--feature .svc__main .svc__top {
    margin-top: 0;
  }
  .svc--feature .svc__main > .checklist {
    margin-bottom: 1.5rem;
  }
  .svc__aside {
    grid-area: aside;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem) clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }
  .svc__foot {
    grid-area: foot;
    align-self: end;
    padding: 0 clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
  }
  .svc__extras {
    padding: 1.25rem;
    border-radius: 18px;
    background: var(--offwhite);
    border: 1px solid var(--line-soft);
  }

  .services__disclaimer {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 2rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--offwhite);
    font-size: 0.92rem;
    color: var(--muted);
  }
  .services__disclaimer :global(svg) {
    flex: none;
    color: var(--blue);
    margin-top: 0.15em;
  }

  @media (max-width: 820px) {
    .services__head {
      grid-template-columns: 1fr;
    }
    .services__grid {
      grid-template-columns: 1fr;
    }
    /* Stacked in reading order: photo, details, add-ons, button. */
    .svc--feature {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'media' 'main' 'aside' 'foot';
      grid-template-rows: auto;
    }
    .svc--feature .svc__main .svc__top {
      margin-top: calc(-1 * clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem) - 28px);
    }
    .svc--feature .svc__main > .checklist {
      margin-bottom: 0;
    }
    .svc__aside {
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }
  /* Compact add-ons on small screens: one wrapping line with dot separators. */
  @media (max-width: 767px) {
    .svc__extras {
      padding: 0.9rem 1rem;
      border-radius: 14px;
    }
    .svc__extras .svc__label {
      margin-bottom: 0.45rem;
    }
    .checklist--plus {
      display: block;
      font-size: 0.92rem;
      line-height: 1.6;
    }
    /* Each add-on moves to the next line as a unit; it only wraps internally if it cannot fit a line on its own. */
    .checklist--plus li {
      display: inline-block;
      max-width: 100%;
    }
    .checklist--plus li:not(:last-child)::after {
      content: '';
      display: inline-block;
      width: 4px;
      height: 4px;
      margin-inline: 0.55rem;
      border-radius: 50%;
      background: var(--cyan);
      vertical-align: middle;
    }
    .checklist--plus :global(svg) {
      display: none;
    }
    .svc__extras .svc__note--box {
      margin-top: 0.8rem;
      padding: 0.65rem 0.8rem;
      font-size: 0.88rem;
      line-height: 1.45;
    }
  }
  @media (max-width: 460px) {
    .checklist--cols {
      grid-template-columns: 1fr;
    }
    .svc__cta {
      align-self: stretch;
    }
    .svc__foot .svc__cta {
      width: 100%;
    }
  }
</style>
