---
import Icon from './Icon.astro';

const items = [
  { icon: 'shield', title: 'Insured', text: 'Peace of mind at every visit' },
  { icon: 'supplies', title: 'Supplies Included', text: 'We arrive fully prepared' },
  { icon: 'paw', title: 'Pet-Friendly', text: 'Your pets are welcome' },
  { icon: 'leaf', title: 'Eco-Friendly Products', text: 'Options available on request' },
];
---

<section class="trust" aria-label="Our commitments">
  <div class="container">
    <ul class="trust__list" role="list">
      {
        items.map((item, i) => (
          <li class="trust__item reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <span class="trust__icon">
              <Icon name={item.icon} size={26} />
            </span>
            <span>
              <strong>{item.title}</strong>
              <span class="trust__text">{item.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .trust {
    position: relative;
    z-index: 2;
    margin-top: calc(clamp(1.5rem, 1rem + 2vw, 2.5rem) * -1);
  }
  .trust__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.5rem;
  }
  .trust__item + .trust__item {
    border-left: 1px solid var(--line-soft);
  }
  .trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--cyan-soft);
    color: var(--blue);
  }
  .trust__item strong {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--blue-ink);
    line-height: 1.3;
  }
  .trust__text {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
    margin-top: 0.2rem;
  }
  @media (max-width: 1000px) {
    .trust__list {
      grid-template-columns: repeat(2, 1fr);
    }
    .trust__item:nth-child(3) {
      border-left: 0;
    }
    .trust__item:nth-child(n + 3) {
      border-top: 1px solid var(--line-soft);
    }
  }
  @media (max-width: 520px) {
    .trust__item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.25rem 1rem;
    }
    .trust__icon {
      width: 44px;
      height: 44px;
    }
    .trust__text {
      display: none;
    }
  }
</style>
