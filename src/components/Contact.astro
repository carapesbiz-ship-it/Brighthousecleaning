---
import Icon from './Icon.astro';
import { services, site, whatsappLink } from '../data/site';

const propertyTypes = ['House', 'Apartment / Condo', 'Airbnb', 'Office / Commercial', 'Other'];
const frequencies = ['One-time', 'Weekly', 'Biweekly', 'Monthly'];
const contactMethods = ['WhatsApp', 'Phone', 'Email'];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Free quote</p>
      <h2 id="contact-title">Ready for a <span class="em">brighter space?</span></h2>
      <p class="lede">Tell us what you need and we’ll help you choose the right service.</p>
    </div>

    <ul class="quick" role="list">
      <li>
        <a class="quick__card" href={whatsappLink()} target="_blank" rel="noopener">
          <span class="quick__icon quick__icon--wa"><Icon name="whatsapp" size={26} /></span>
          <span>
            <strong>WhatsApp</strong>
            <span>Fastest reply · {site.phone.display}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="quick__card" href={site.phone.href}>
          <span class="quick__icon"><Icon name="phone" size={24} /></span>
          <span>
            <strong>Call</strong>
            <span>{site.phone.display}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="quick__card" href={`mailto:${site.email}`}>
          <span class="quick__icon"><Icon name="mail" size={24} /></span>
          <span>
            <strong>Email</strong>
            <span class="quick__email">{site.email}</span>
          </span>
        </a>
      </li>
    </ul>

    <div class="contact__grid">
      <aside class="contact__info" aria-label="Hours and service area">
        <div class="info-block">
          <span class="info-block__icon"><Icon name="clock" /></span>
          <div>
            <h3>Hours</h3>
            <p>{site.hours.days}<br />{site.hours.time}</p>
          </div>
        </div>
        <div class="info-block">
          <span class="info-block__icon"><Icon name="pin" /></span>
          <div>
            <h3>Service area</h3>
            <p>All of Metro Vancouver, from Vancouver and the North Shore to Richmond, Delta, Surrey, and the Tri-Cities.</p>
          </div>
        </div>
        <div class="info-block">
          <span class="info-block__icon"><Icon name="globe" /></span>
          <div>
            <h3>Languages</h3>
            <p>English &amp; Spanish<br /><span lang="es">Se habla español</span></p>
          </div>
        </div>
        <div class="contact__promise">
          <Icon name="star" size={20} />
          <p><strong>5-Star Promise.</strong> Not completely satisfied? Tell us within 24 hours and we’ll make it right.</p>
        </div>
      </aside>

      <form
        class="quote"
        id="quote-form"
        name="quote"
        method="POST"
        action="/thank-you/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        novalidate
        data-quote-form
        data-wa-hide
        aria-describedby="quote-required-note"
      >
        <input type="hidden" name="form-name" value="quote" />
        <p class="visually-hidden" aria-hidden="true">
          <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="quote__head">
          <h3>Request your free quote</h3>
          <p id="quote-required-note" class="quote__req">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>
        </div>

        <div class="quote__summary" role="alert" data-error-summary hidden>
          <Icon name="alert" size={20} />
          <div>
            <p><strong>Please check the highlighted fields.</strong></p>
            <ul data-error-list></ul>
          </div>
        </div>

        <fieldset class="quote__group">
          <legend>About you</legend>
          <div class="field field--full">
            <label for="f-name">Full name <span class="req" aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" data-label="Full name" />
            <p class="field__error" id="f-name-err" data-error></p>
          </div>
          <div class="field">
            <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-err" data-label="Email" />
            <p class="field__error" id="f-email-err" data-error></p>
          </div>
          <div class="field">
            <label for="f-phone">Phone number <span class="req" aria-hidden="true">*</span></label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="f-phone-hint f-phone-err" data-label="Phone number" />
            <p class="field__hint" id="f-phone-hint">e.g. (604) 555-0123</p>
            <p class="field__error" id="f-phone-err" data-error></p>
          </div>
          <div class="field field--full">
            <span class="field__label" id="f-method-label">Preferred contact method</span>
            <div class="chips" role="radiogroup" aria-labelledby="f-method-label">
              {
                contactMethods.map((m, i) => (
                  <label class="chip">
                    <input type="radio" name="contact-method" value={m} checked={i === 0} />
                    <span>{m}</span>
                  </label>
                ))
              }
            </div>
          </div>
        </fieldset>

        <fieldset class="quote__group">
          <legend>About your space</legend>
          <div class="field">
            <label for="f-service">Service needed <span class="req" aria-hidden="true">*</span></label>
            <div class="select">
              <select id="f-service" name="service" required aria-describedby="f-service-err" data-label="Service needed">
                <option value="">Choose a service</option>
                {services.map((s) => <option value={s.name} data-id={s.id}>{s.name}</option>)}
                <option value="Not sure yet">Not sure yet</option>
              </select>
              <Icon name="chevron" size={18} />
            </div>
            <p class="field__error" id="f-service-err" data-error></p>
          </div>
          <div class="field">
            <label for="f-property">Property type</label>
            <div class="select">
              <select id="f-property" name="property-type">
                <option value="">Select</option>
                {propertyTypes.map((p) => <option value={p}>{p}</option>)}
              </select>
              <Icon name="chevron" size={18} />
            </div>
          </div>
          <div class="field">
            <label for="f-city">City <span class="req" aria-hidden="true">*</span></label>
            <input id="f-city" name="city" type="text" autocomplete="address-level2" list="city-list" required aria-describedby="f-city-err" data-label="City" />
            <datalist id="city-list">
              <option value="Vancouver"></option><option value="Burnaby"></option><option value="Richmond"></option>
              <option value="Surrey"></option><option value="New Westminster"></option><option value="Coquitlam"></option>
              <option value="Port Coquitlam"></option><option value="Port Moody"></option><option value="Delta"></option>
              <option value="North Vancouver"></option><option value="West Vancouver"></option>
            </datalist>
            <p class="field__error" id="f-city-err" data-error></p>
          </div>
          <div class="field">
            <label for="f-frequency">Preferred frequency</label>
            <div class="select">
              <select id="f-frequency" name="frequency">
                <option value="">Select</option>
                {frequencies.map((f) => <option value={f}>{f}</option>)}
              </select>
              <Icon name="chevron" size={18} />
            </div>
          </div>
          <div class="field field--half">
            <label for="f-bedrooms">Bedrooms <span class="opt">(optional)</span></label>
            <input id="f-bedrooms" name="bedrooms" type="number" min="0" max="20" inputmode="numeric" aria-describedby="f-bedrooms-err" data-label="Bedrooms" />
            <p class="field__error" id="f-bedrooms-err" data-error></p>
          </div>
          <div class="field field--half">
            <label for="f-bathrooms">Bathrooms <span class="opt">(optional)</span></label>
            <input id="f-bathrooms" name="bathrooms" type="number" min="0" max="20" step="0.5" inputmode="decimal" aria-describedby="f-bathrooms-err" data-label="Bathrooms" />
            <p class="field__error" id="f-bathrooms-err" data-error></p>
          </div>
          <div class="field field--full">
            <label for="f-date">Preferred service date <span class="opt">(optional)</span></label>
            <input id="f-date" name="preferred-date" type="date" aria-describedby="f-date-err" data-label="Preferred service date" />
            <p class="field__error" id="f-date-err" data-error></p>
          </div>
          <div class="field field--full">
            <label for="f-message">Message or special priorities <span class="opt">(optional)</span></label>
            <textarea id="f-message" name="message" rows="4" maxlength="2000" placeholder="Pets, product preferences, areas that need extra attention…"></textarea>
          </div>
        </fieldset>

        <div class="field field--full consent">
          <label class="check">
            <input type="checkbox" name="consent" value="yes" required aria-describedby="f-consent-err" data-label="Consent" id="f-consent" />
            <span class="check__box" aria-hidden="true"><Icon name="check" size={16} /></span>
            <span>I agree that Bright House may contact me about this quote request. <span class="req" aria-hidden="true">*</span></span>
          </label>
          <p class="field__error" id="f-consent-err" data-error></p>
        </div>

        <div class="quote__submit">
          <button class="btn btn--primary" type="submit" data-submit>
            Send My Quote Request
            <Icon name="arrow" />
          </button>
          <p class="quote__privacy">
            We only use your details to respond to your request. See our <a href="/privacy/">Privacy Policy</a>.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    background:
      radial-gradient(70% 50% at 50% 0%, var(--cyan-soft), transparent 70%),
      var(--white);
  }

  /* Quick contact */
  .quick {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
    max-width: 62rem;
  }
  .quick__card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--white);
    text-decoration: none;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.3s var(--ease),
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .quick__card:hover {
    transform: translateY(-3px);
    border-color: var(--blue);
    box-shadow: var(--shadow);
  }
  .quick__card strong {
    display: block;
    font-family: var(--font-accent);
    font-size: 0.95rem;
    color: var(--blue-ink);
  }
  .quick__card span span {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .quick__email {
    word-break: break-all;
  }
  .quick__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--cyan-soft);
    color: var(--blue);
  }
  .quick__icon--wa {
    background: #e7f6ee;
    color: var(--whatsapp);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* Info column */
  .contact__info {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--blue);
    color: rgb(255 255 255 / 0.88);
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  .info-block {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }
  .info-block__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--cyan);
  }
  .info-block h3 {
    font-family: var(--font-accent);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan-on-blue);
    margin-bottom: 0.35rem;
  }
  .info-block p {
    color: var(--white);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .contact__promise {
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    margin-top: 0.25rem;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .contact__promise :global(svg) {
    flex: none;
    color: var(--cyan);
    fill: var(--cyan);
    margin-top: 0.1em;
  }
  .contact__promise strong {
    color: var(--white);
  }

  /* Form */
  .quote {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-l);
  }
  .quote__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }
  .quote__req {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .req {
    color: var(--error);
    font-weight: 700;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85em;
  }
  .quote__summary {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    margin-bottom: 1.5rem;
    border-radius: 14px;
    background: var(--error-bg);
    border: 1px solid rgb(180 35 24 / 0.25);
    color: var(--error);
    font-size: 0.92rem;
  }
  .quote__summary :global(svg) {
    flex: none;
    margin-top: 0.1em;
  }
  .quote__summary ul {
    margin: 0.35rem 0 0;
    padding-left: 1.1rem;
  }
  .quote__summary a {
    color: var(--error);
  }
  .quote__group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1.1rem;
    margin: 0 0 1.75rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .quote__group legend {
    grid-column: 1 / -1;
    width: 100%;
    padding: 0 0 0.9rem;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-accent);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field label,
  .field__label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--blue-ink);
  }
  .field input:not([type='radio'], [type='checkbox']),
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1.5px solid var(--line);
    background: var(--offwhite);
    font-size: 1rem;
    color: var(--ink);
    transition:
      border-color 0.2s,
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #7c8394;
  }
  .field input:not([type='radio'], [type='checkbox']):hover,
  .field select:hover,
  .field textarea:hover {
    border-color: #c5d1dd;
  }
  .field input:not([type='radio'], [type='checkbox']):focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--blue);
    background: var(--white);
    box-shadow: 0 0 0 4px rgb(62 64 149 / 0.14);
  }
  .field [aria-invalid='true'] {
    border-color: var(--error) !important;
    background: var(--error-bg) !important;
  }
  .field [aria-invalid='true']:focus {
    box-shadow: 0 0 0 4px rgb(180 35 24 / 0.14) !important;
  }
  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }
  .select :global(svg) {
    position: absolute;
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--blue);
  }
  .field__hint {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .field__error {
    display: none;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--error);
  }
  .field__error:not(:empty) {
    display: flex;
  }
  .field__error:not(:empty)::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--error);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 800;
  }

  /* Chips (radio) */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 46px;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    border: 1.5px solid var(--line);
    background: var(--offwhite);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    transition: all 0.2s;
  }
  .chip span::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    border: 1.5px solid var(--muted);
    transition: all 0.2s;
  }
  .chip input:checked + span {
    border-color: var(--blue);
    background: var(--cyan-soft);
    color: var(--blue-ink);
  }
  .chip input:checked + span::before {
    border-color: var(--blue);
    background: var(--blue);
    box-shadow: inset 0 0 0 2px var(--white);
  }
  .chip input:focus-visible + span {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  /* Checkbox */
  .consent {
    margin-bottom: 1.5rem;
  }
  .check {
    position: relative;
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    font-weight: 500 !important;
    font-size: 0.95rem !important;
    line-height: 1.5;
    cursor: pointer;
  }
  .check input {
    position: absolute;
    opacity: 0;
    width: 26px;
    height: 26px;
    margin: 0;
    cursor: pointer;
  }
  .check__box {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    border: 1.5px solid #9aa3b5;
    background: var(--white);
    color: transparent;
    transition: all 0.2s;
  }
  .check input:checked + .check__box {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--white);
  }
  .check input:focus-visible + .check__box {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }
  .check input[aria-invalid='true'] + .check__box {
    border-color: var(--error);
    background: var(--error-bg);
  }

  .quote__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .quote__submit .btn {
    min-height: 56px;
    padding-inline: 2rem;
  }
  .quote__privacy {
    flex: 1 1 16rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .quote__privacy a {
    color: var(--blue);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .contact__info {
      position: static;
      order: 2;
    }
  }
  @media (max-width: 760px) {
    .quick {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .quote__group {
      grid-template-columns: 1fr;
    }
    .field--half {
      grid-column: auto;
    }
    .quote__group:nth-of-type(2) {
      grid-template-columns: 1fr 1fr;
    }
    .quote__group:nth-of-type(2) .field:not(.field--half) {
      grid-column: 1 / -1;
    }
    .quote__submit .btn {
      width: 100%;
    }
  }
</style>
