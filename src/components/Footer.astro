---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer on-dark" data-wa-hide>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo variant="white" height={64} />
        <p class="footer__tagline">{site.tagline}.</p>
        <p class="footer__lang">
          <Icon name="globe" size={18} />
          English &amp; Spanish · Se habla español
        </p>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Contact</h2>
        <ul role="list">
          <li>
            <a href={site.phone.href}><Icon name="phone" size={18} />{site.phone.display}</a>
          </li>
          <li>
            <a href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} />WhatsApp</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
          </li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Hours</h2>
        <p class="footer__text">
          {site.hours.days}<br />
          {site.hours.time}
        </p>
        <h2 class="footer__title footer__title--spaced">Service area</h2>
        <p class="footer__text">All of Metro Vancouver</p>
      </div>

      <div class="footer__col">
        <h2 class="footer__title">Explore</h2>
        <ul role="list" class="footer__nav">
          {
            nav.slice(1).map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
      <div class="footer__social">
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Bright House on Instagram">
          <Icon name="instagram" size={20} />
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Bright House on Facebook">
          <Icon name="facebook" size={20} />
        </a>
        <a href="/privacy/" class="footer__privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--blue-ink);
    color: rgb(255 255 255 / 0.82);
    padding-block: clamp(3.5rem, 3rem + 3vw, 5.5rem) 2rem;
    font-size: 0.95rem;
    overflow: hidden;
  }
  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--blue), var(--cyan), var(--blue));
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 1fr 0.8fr;
    gap: 2.5rem;
  }
  .footer__tagline {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--white);
    max-width: 18rem;
    line-height: 1.3;
  }
  .footer__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--white);
  }
  .footer__lang :global(svg) {
    color: var(--cyan);
  }
  .footer__title {
    font-family: var(--font-accent);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 1rem;
  }
  .footer__title--spaced {
    margin-top: 1.75rem;
  }
  .footer ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }
  .footer a {
    color: var(--white);
    text-decoration: none;
  }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    word-break: break-word;
  }
  .footer__col a :global(svg) {
    color: var(--cyan);
    flex: none;
  }
  .footer__col a:hover,
  .footer__privacy:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer__text {
    color: var(--white);
    line-height: 1.7;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: 0.85rem;
  }
  .footer__social {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .footer__social a:not(.footer__privacy) {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.22);
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .footer__social a:not(.footer__privacy):hover {
    background: rgb(255 255 255 / 0.1);
    border-color: var(--cyan);
  }
  .footer__privacy {
    margin-left: 0.75rem;
    padding-block: 0.6rem;
  }

  @media (max-width: 960px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer {
      padding-bottom: 6.5rem; /* room for floating WhatsApp button */
    }
  }
</style>
