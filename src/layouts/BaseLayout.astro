---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-700.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/comfortaa/latin-400.css';
import '@fontsource/comfortaa/latin-700.css';
import '@fontsource-variable/figtree';
import '../styles/global.css';

import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site } from '../data/site';

// Above-the-fold fonts are preloaded to avoid layout shift when they swap in.
import fontDisplay from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import fontDisplayItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import fontBody from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import fontAccent from '@fontsource/comfortaa/files/comfortaa-latin-700-normal.woff2?url';
const preloadFonts = [fontDisplay, fontDisplayItalic, fontBody, fontAccent];

interface Props {
  title?: string;
  description?: string;
  /** Path used for the canonical URL, e.g. "/privacy/" */
  path?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title = site.seo.title, description = site.seo.description, path = Astro.url.pathname, noindex = false, schema = [] } = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#3E4095" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Bright House Cleaning Services logo beside a spotless kitchen island with fresh flowers" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <slot name="head" />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <TopBar />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
